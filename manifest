appname                    = airplay2dlna
version                    = 1.0.0
display_name               = AirPlay 2 → DLNA 桥接
desc                       = 把任意 DLNA/UPnP 音响变成 AirPlay 2 音箱。应用原生运行在飞牛 NAS 上（不使用 Docker），内置 AirPlay 2 接收器，把 Apple 设备推来的音频实时转成 PCM 流经 HTTP 推送到局域网 DLNA MediaRenderer，并提供 Web UI 管理 AirPlay 名称、DLNA 设备选择、播放状态与日志。
platform                   = x86
source                     = thirdparty
maintainer                 = AirPlay2-DLNA-Bridge Project
maintainer_url             = https://github.com/
distributor                = AirPlay2-DLNA-Bridge Project
distributor_url            = https://github.com/
os_min_version             = 1.1.8
desktop_uidir              = ui
desktop_applaunchname      = airplay2dlna.main
install_dep_apps           = python312
service_port               = 8788
checkport                  = true
ctl_stop                   = true
disable_authorization_path = true
changelog                  = 1.0.0 首个版本：原生 AirPlay 2 接收（shairport-sync + NQPTP）、DLNA 自动发现、实时 PCM 桥接、播放状态同步、Web UI。
